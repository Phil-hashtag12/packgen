# ── Required ──────────────────────────────────────────────────────────────────
# Choose one AI backend (openrouter is cheaper for classification)
AI_BACKEND=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
# OR: AI_BACKEND=anthropic + ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (auth + per-user keys + scores) ──────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Redis (job state + rate limits) ──────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379/0

# ── App security ──────────────────────────────────────────────────────────────
FLASK_SECRET=change_me_generate_with_python_secrets_token_hex_32
ADMIN_TOKEN=change_me_strong_random_string

# ── Optional tuning ───────────────────────────────────────────────────────────
FREE_QUOTA_PER_MONTH=500
PRO_QUOTA_PER_MONTH=5000
JOB_TTL_SECONDS=21600
FILE_TTL_SECONDS=28800
SESSION_TTL_SECONDS=2592000
OR_TEXT_MODEL=google/gemini-flash-1.5-8b
OR_VISION_MODEL=google/gemini-flash-1.5
SENTRY_DSN=https://xxx@sentry.io/xxx
